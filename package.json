{
  "name": "wirepn-windows",
  "version": "0.1.0",
  "private": false,
  "description": "WirePN Windows client",
  "main": "out/main/index.js",
  "author": "WirePN",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.1.1",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "9.38.0",
    "typescript": "6.0.2",
    "vite": "7.3.1",
    "vitest": "4.1.2"
  },
  "build": {
    "appId": "ru.wirepn.client",
    "productName": "WirePN",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "runtime/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/bin",
        "to": "runtime/bin"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
